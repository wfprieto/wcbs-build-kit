{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project_id", "goals", "updated_at"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "goals": {
      "type": "array",
      "minItems": 17,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": ["goal_id", "applicable", "execution_path", "verification_path", "evidence_state"],
        "properties": {
          "goal_id": {"type": "string", "minLength": 1},
          "applicable": {"type": "boolean"},
          "execution_path": {"type": "string", "minLength": 1},
          "verification_path": {"type": "string", "minLength": 1},
          "evidence_state": {"enum": ["Verified", "Likely", "Suspected", "Unknown", "Not Run", "Blocked"]}
        },
        "additionalProperties": false
      }
    },
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
