{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wfprieto/wcbs-build-kit/runtime_adapters/schemas/adapter-manifest.schema.json",
  "title": "WCBS Adapter Manifest",
  "description": "Canonical source of truth for one runtime adapter. CAPABILITY_MATRIX.md is generated from these files.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtime_id", "display_name", "owner", "support_level", "activation_tier", "integration_shape", "native_install_mechanism", "install_scope", "bootstrap_path", "bootstrap_mode", "activation_marker", "tool_mapping_path", "capabilities", "fallbacks", "supported_runtime_versions", "supported_operating_systems", "modifies_user_files", "install", "update", "uninstall", "rollback", "limitations", "deprecation"
  ],
  "properties": {
    "runtime_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "display_name": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "support_level": {"enum": ["Full", "Partial", "Manual", "Unsupported"]},
    "activation_tier": {"enum": ["T1", "T2", "T3", "T4"], "description": "T1 native enforced delivery; T2 always-on instruction; T3 user-requested fetch; T4 manual Kernel content."},
    "integration_shape": {"enum": ["session_start_hook", "in_process_plugin", "always_on_instruction_file", "hybrid"]},
    "native_install_mechanism": {"type": "string", "minLength": 1},
    "install_scope": {"enum": ["project", "global"]},
    "bootstrap_path": {"type": "string", "minLength": 1},
    "bootstrap_mode": {"enum": ["automatic", "manual"]},
    "activation_marker": {"type": "string", "pattern": "^WCBS_KIT_ACTIVE:[a-z0-9-]+$"},
    "tool_mapping_path": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_read", "file_write", "file_edit", "execute_command", "subagents", "task_tracking", "web_access", "browser_verification", "durable_artifact_storage", "human_approval_gates"],
      "properties": {
        "file_read": {"$ref": "#/$defs/availability"},
        "file_write": {"$ref": "#/$defs/availability"},
        "file_edit": {"$ref": "#/$defs/availability"},
        "execute_command": {"$ref": "#/$defs/availability"},
        "subagents": {"$ref": "#/$defs/availability"},
        "task_tracking": {"$ref": "#/$defs/availability"},
        "web_access": {"$ref": "#/$defs/availability"},
        "browser_verification": {"$ref": "#/$defs/availability"},
        "durable_artifact_storage": {"$ref": "#/$defs/availability"},
        "human_approval_gates": {"$ref": "#/$defs/availability"}
      }
    },
    "fallbacks": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "supported_runtime_versions": {"type": "string", "minLength": 1},
    "supported_operating_systems": {"type": "array", "minItems": 1, "items": {"enum": ["macos", "linux", "windows"]}},
    "modifies_user_files": {"type": "boolean"},
    "install": {"type": "string", "minLength": 1},
    "update": {"type": "string", "minLength": 1},
    "uninstall": {"type": "string", "minLength": 1},
    "rollback": {"type": "string", "minLength": 1},
    "limitations": {"type": "string", "minLength": 1},
    "deprecation": {"type": "string", "minLength": 1}
  },
  "$defs": {"availability": {"enum": ["native", "degradable", "unavailable"]}}
}
