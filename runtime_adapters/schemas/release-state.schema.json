{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "gate": {
      "type": "object",
      "required": ["status", "evidence_state", "summary"],
      "properties": {
        "status": {"enum": ["PASS", "CONDITIONAL PASS", "PARTIAL", "FAIL", "BLOCKED"]},
        "evidence_state": {"enum": ["Verified", "Likely", "Suspected", "Unknown", "Not Run", "Blocked"]},
        "summary": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["verdict", "gates", "blockers", "accepted_risks", "updated_at"],
  "properties": {
    "verdict": {"enum": ["PASS", "CONDITIONAL PASS", "PARTIAL", "FAIL", "BLOCKED"]},
    "gates": {
      "type": "object",
      "required": ["A", "B", "C", "D", "E", "F", "G", "H", "I"],
      "properties": {
        "A": {"$ref": "#/$defs/gate"},
        "B": {"$ref": "#/$defs/gate"},
        "C": {"$ref": "#/$defs/gate"},
        "D": {"$ref": "#/$defs/gate"},
        "E": {"$ref": "#/$defs/gate"},
        "F": {"$ref": "#/$defs/gate"},
        "G": {"$ref": "#/$defs/gate"},
        "H": {"$ref": "#/$defs/gate"},
        "I": {"$ref": "#/$defs/gate"}
      },
      "additionalProperties": false
    },
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "accepted_risks": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
