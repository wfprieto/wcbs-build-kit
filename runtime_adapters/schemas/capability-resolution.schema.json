{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["project_id", "capabilities", "evidence_state", "resolved_at"],
  "properties": {
    "project_id": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "applicable", "justification", "subcapabilities", "resolved_skills", "resolved_audits", "resolved_templates", "resolved_gates", "ceiling"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "applicable": {"type": "boolean"},
          "justification": {"type": "string", "minLength": 1},
          "subcapabilities": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resolved_skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resolved_audits": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resolved_templates": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resolved_gates": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "ceiling": {"enum": ["Full", "Partial", "Manual", "Unsupported"]}
        },
        "additionalProperties": false
      }
    },
    "evidence_state": {"enum": ["Verified", "Likely", "Suspected", "Unknown", "Not Run", "Blocked"]},
    "resolved_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
