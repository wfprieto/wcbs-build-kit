{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|fork|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/scripts/render-session-bootstrap.mjs\" --runtime codex --shape codex",
            "statusMessage": "Loading WCBS workflow"
          }
        ]
      }
    ]
  }
}
