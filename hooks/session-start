#!/usr/bin/env bash
# Native WCBS SessionStart transport. The renderer owns JSON escaping and shape
# selection so a Cursor payload can never accidentally use Claude's contract.
unset BASH_ENV ENV CDPATH GLOBIGNORE
IFS=$' \t\n'
export LC_ALL=C
set -euo pipefail

PLUGIN_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
NODE_BIN="${NODE:-node}"

runtime="github-copilot"
shape="sdk"
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  runtime="cursor"
  shape="cursor"
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  runtime="claude"
  shape="claude"
fi

exec "$NODE_BIN" "$PLUGIN_ROOT/scripts/render-session-bootstrap.mjs" --runtime "$runtime" --shape "$shape"
